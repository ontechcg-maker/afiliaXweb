# ================================================================
# AfiliaX Server — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ================================================================

# Porta do servidor
PORT=3001

# Origins permitidos para CORS
ALLOWED_ORIGINS=http://localhost:5173,https://app.ontechcg.cloud

# ================================================================
# Supabase — Banco de Dados Multi-Tenant
# Supabase > Project Settings > API
# ================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# IMPORTANTE: Service Role Key (fica apenas no servidor — NUNCA exponha no frontend!)
# Supabase > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ================================================================
# Evolution API — WhatsApp (Instâncias de TODOS os clientes)
# Esta URL/chave é adminstrativa — os clientes não veem isso
# ================================================================
EVOLUTION_BASE_URL=https://api.ontechcg.cloud
EVOLUTION_API_KEY=sua-chave-master-da-evolution-api

# E-mail do Administrador Principal do SaaS
ADMIN_EMAIL=hevertonsalvador.cg@gmail.com

# Redis para Fila de Disparos Assíncronos (Opcional - Fallback automático em memória)
REDIS_URL=redis://localhost:6379

